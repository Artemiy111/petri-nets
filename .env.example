# Sentry / GlitchTip DSN for error reporting. Empty disables reporting.
SENTRY_DSN=
# Environment tag shown next to events.
SENTRY_ENVIRONMENT=production
# Release tag, e.g. the image tag or git sha. Optional.
SENTRY_RELEASE=
# Pageload transaction sample rate, 0..1. 0 disables performance tracing.
SENTRY_TRACES_SAMPLE_RATE=0

# OTLP/HTTP endpoint for traces, e.g. http://otel-collector.monitoring.svc.cluster.local:4318.
# Empty disables server tracing.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Reported as service.name.
OTEL_SERVICE_NAME=petri-nets
# Reported as deployment.environment.name.
OTEL_ENVIRONMENT=production
# Reported as service.version. Falls back to SENTRY_RELEASE.
OTEL_SERVICE_VERSION=
# Trace sample rate, 0..1. Defaults to 1 when the endpoint is set.
OTEL_TRACES_SAMPLE_RATE=1
# Browser trace sample rate, 0..1. Empty falls back to OTEL_TRACES_SAMPLE_RATE;
# 0 keeps the browser SDK out of the bundle.
OTEL_BROWSER_SAMPLE_RATE=
